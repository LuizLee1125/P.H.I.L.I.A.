{
  "name": "jarvis-assistant",
  "version": "1.0.0",
  "description": "Local voice assistant powered by Gemini and Playwright",
  "main": "dist/main.js",
  "type": "module",
  "scripts": {
    "start": "npm --prefix backend start",
    "backend": "npm --prefix backend start",
    "backend:dev": "npm --prefix backend run dev",
    "frontend": "npm --prefix frontend run dev",
    "app": "node scripts/launch-app.js",
    "tauri": "npm --prefix frontend run tauri",
    "tauri:dev": "npm --prefix frontend run tauri dev",
    "tauri:build": "npm --prefix frontend run tauri build",
    "build": "npm --prefix backend run build && npm --prefix frontend run build",
    "test": "npm --prefix backend test"
  },
  "dependencies": {
    "@google/genai": "^2.24.0",
    "@picovoice/porcupine-node": "^4.0.2",
    "@picovoice/pvrecorder-node": "^1.2.9",
    "@types/node": "^26.6.2",
    "dotenv": "^18.0.3",
    "open": "^11.0.4",
    "playwright": "^1.63.0",
    "sound-play": "^1.1.0",
    "trash": "^10.1.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
